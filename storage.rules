
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for all assets to ensure site identity loads fast
    match /{allPaths=**} {
      allow read: if true;
    }

    // Simplified write access for debugging and speed
    // This allows any logged-in user to write to the bucket.
    // It solves the "stuck" issue by removing slow Firestore lookups from the rules engine.
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
