rules_version = '2';

// WARNING: These rules are insecure and are for debugging purposes only.
// They allow public read and write access to your storage bucket.
// You should secure your rules before deploying to production.
service firebase.storage {
  match /b/{bucket}/o {
    // This rule allows any user to read and write to the sliders directory.
    match /sliders/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Fallback rule: Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
