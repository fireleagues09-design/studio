rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for slider images
    match /sliders/{allPaths=**} {
      allow read;
      allow write: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
