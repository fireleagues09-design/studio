rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ✅ ALLOW FAVICON UPLOADS
    match /fav-icon/{allPaths=**} {
      allow read, write: if true;
    }

    // ✅ ALLOW CONSOLIDATED APP IMAGES (Support, etc)
    match /images/{allPaths=**} {
      allow read, write: if true;
    }

    // 🔒 Keep everything else blocked by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
