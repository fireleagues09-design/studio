
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Optimized check for testing and production
    function isAdmin() {
      return isUserAuthenticated() && (
        request.auth.token.isAdmin == true || 
        request.auth.token.isSupport == true || 
        request.auth.token.isEmployee == true ||
        (
          exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          (get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
           get(/databases/(default)/documents/users/$(request.auth.uid)).data.isSupport == true ||
           get(/databases/(default)/documents/users/$(request.auth.uid)).data.isEmployee == true)
        )
      );
    }

    // Public read for all assets
    match /{allPaths=**} {
      allow read: if true;
    }

    // Specific folder for favicons with resilient rules
    match /fav-icon/{fileName} {
      allow write: if isUserAuthenticated();
    }

    match /sliders/{fileName} {
      allow write: if isAdmin();
    }

    match /branding/{fileName} {
      allow write: if isAdmin();
    }

    match /support_images/{userId}/{allPaths=**} {
      allow write: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
