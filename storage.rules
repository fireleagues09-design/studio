
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public read access for all files
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Only authenticated admins can upload to the 'sliders' directory.
    // The rule checks the 'isAdmin' field in the user's Firestore document.
    match /sliders/{fileName} {
      allow write: if request.auth != null && 
                      get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
