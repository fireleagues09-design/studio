rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ✅ GLOBAL IMAGES FOLDER (Requested Fix)
    // Consolidating all uploads here for maximum performance and reliability
    match /images/{allPaths=**} {
      allow read, write: if true;
    }

    // 🔒 Keep everything else blocked by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}