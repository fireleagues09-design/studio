
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /sliders/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // Allow read access on all other paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false; // Deny writes by default to other paths
    }
  }
}
