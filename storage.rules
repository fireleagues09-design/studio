
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to slider images
    match /sliders/{allPaths=**} {
      allow read;
      // Allow writes only for authenticated admins
      allow write: if request.auth != null && 
                      get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // You can add other rules for other paths here
    // For example, for user profile pictures:
    // match /users/{userId}/{allPaths=**} {
    //   allow read;
    //   allow write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
