rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check admin status
    function isAdmin() {
      return exists(/databases/(default)/documents/users/$(request.auth.uid)) && 
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Admins can read and write to the sliders directory
    match /sliders/{allPaths=**} {
      allow read; // Sliders are public
      allow write: if isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
