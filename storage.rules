rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ✅ Allow favicon uploads (requested fix)
    match /fav-icon/{allPaths=**} {
      allow read, write: if true;
    }

    // ✅ Allow support image uploads (ensures all tabs function correctly)
    match /support_images/{allPaths=**} {
      allow read, write: if true;
    }

    // 🔒 Keep everything else blocked by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}