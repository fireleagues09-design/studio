rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Files can be read by anyone.
    match /{allPaths=**} {
      allow read;
    }

    // Only authenticated admins can upload to the 'sliders' folder.
    // The rule checks the 'isAdmin' flag on the user's document in Firestore.
    match /sliders/{allPaths=**} {
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
