
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for roles
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Direct check for admin/employee flags to avoid recursion in rules
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isUserAuthenticated() && getUserData().isAdmin == true;
    }

    function isEmployee() {
      let data = getUserData();
      return isUserAuthenticated() && (data.isEmployee == true || data.isEmployee == 1);
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow get: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin() || isEmployee());
      allow list: if isAdmin() || isEmployee();
      allow create: if isUserAuthenticated() && request.auth.uid == userId;
      allow update: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isAdmin();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // Rules for Chat Support
    match /chats/{chatId} {
      // Players can read/write their own chats. Admins can read all.
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isUserAuthenticated();
      allow update: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      match /messages/{messageId} {
        // Only allow reading messages if user owns the chat or is an admin
        allow read: if isUserAuthenticated() && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin());
        // Only allow sending messages if user is part of the chat or is an admin
        allow create: if isUserAuthenticated() && (get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid || isAdmin());
      }
    }

    // Rules for the 'tournaments' collection
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // Rules for the 'transactions' collection
    match /transactions/{transactionId} {
      allow list: if request.auth.uid != null;
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      allow update: if isAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
