
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Role checks: These functions read the user's document.
    // To avoid recursion, the rules for /users/{userId} must allow 
    // owner access without calling these functions.
    function isAdmin() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userDoc) && 
             get(userDoc).data.get('isAdmin', false) == true;
    }

    function isSupport() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userDoc) && 
             get(userDoc).data.get('isSupport', false) == true;
    }

    function isEmployee() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userDoc) && 
             (get(userDoc).data.get('isEmployee', false) == true || get(userDoc).data.get('isAdmin', false) == true);
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {
      // CRITICAL: Check owner FIRST. No role functions called here to prevent recursion.
      allow get: if isUserAuthenticated() && request.auth.uid == userId;
      
      // Staff can read other profiles
      allow get: if isAdmin() || isEmployee();
      allow list: if isAdmin() || isEmployee();
      
      allow create: if isUserAuthenticated() && request.auth.uid == userId;
      allow update: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isAdmin();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ======================
    // ✅ CHAT SUPPORT SYSTEM
    // ======================
    match /chats/{chatId} {
      // Players create their own sessions
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Players can read/query their own. Support staff can read all.
      // 'list' is required for query() calls.
      allow read, list: if isUserAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isSupport()
      );
      
      // Both can update status or lastMessageTime.
      allow update: if isUserAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isSupport()
      );

      allow delete: if isAdmin();
    }

    // Messages Root Collection
    match /messages/{chatId}/chat/{msgId} {
      // Access allowed if user is Support or the Chat Owner
      allow read, write: if isUserAuthenticated() && (
        isSupport() ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid
      );
    }

    // ======================
    // Other Collections
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /transactions/{transactionId} {
      allow list: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow create: if isUserAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
