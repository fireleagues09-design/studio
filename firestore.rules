
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true;
    }

    // Users can read their own data and admins can read any user data
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin(request.auth.uid);
      allow create: if request.auth.uid == userId;
    }

    // Transactions can be read by the user they belong to, or by an admin
    match /transactions/{transactionId} {
      allow read: if request.auth.uid == resource.data.userId || isAdmin(request.auth.uid);
      allow create: if request.auth.uid != null;
    }
    
    // Sliders can be read by anyone, but only managed by admins
    match /sliders/{sliderId} {
        allow read, list: if true;
        allow create, update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Tournaments can be read by anyone
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      
      // Admins can perform any write operation
      allow write: if request.auth != null && isAdmin(request.auth.uid);

      // Authenticated users can update specific fields for registration
      allow update: if request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['slotsFilled', 'registeredPlayers']);
    }
  }
}
