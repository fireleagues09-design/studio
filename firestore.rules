rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isUserAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSupport == true ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isEmployee == true);
    }

    // ======================
    // Public Read (Fixes homepage)
    // ======================
    match /{document=**} {
      allow read: if true;
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {

      allow get: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isUserAuthenticated() && request.auth.uid == userId;

      allow update: if isUserAuthenticated() &&
                    (request.auth.uid == userId || isAdmin());

      match /teams/{teamId} {
        allow read: if true;
        allow create, delete: if isUserAuthenticated() && request.auth.uid == userId;
        allow update: if isUserAuthenticated() &&
                      request.auth.uid == userId &&
                      request.resource.data.diff(resource.data).changedKeys()
                        .hasOnly(['members', 'category']);
        allow read, write, list: if isAdmin();
      }
    }

    // ======================
    // Sliders & Banners
    // ======================
    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ======================
    // Settings
    // ======================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ======================
    // Tournaments
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow write: if isAdmin();

      match /registrations/{userId} {
        allow create: if isUserAuthenticated() && request.auth.uid == userId;
        allow read, list, delete: if isAdmin();
      }
    }

    // ======================
    // Transactions
    // ======================
    match /transactions/{transactionId} {
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isUserAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow list, write: if isAdmin();
    }

    // ======================
    // Withdrawals
    // ======================
    match /withdrawals/{withdrawalId} {
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isUserAuthenticated() && request.auth.uid == resource.data.userId;
      allow list, write: if isAdmin();
    }

    // ======================
    // Admin Logs
    // ======================
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // ======================
    // ✅ CHAT & TICKETS SUPPORT
    // ======================
    match /chats/{chatId} {

      // allow any logged-in user to create chat or ticket
      allow create: if request.auth != null;

      // allow user to read their chat + admin
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.userId
      );

      // allow admin to modify and user to send updates
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      
      // allow admin to delete
      allow delete: if isAdmin();
    }

    // ======================
    // ✅ MESSAGES
    // ======================
    match /chats/{chatId}/messages/{messageId} {

      allow create: if request.auth != null;

      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.senderId ||
        request.auth.uid ==
          get(/databases/$(database)/documents/chats/$(chatId)).data.userId
      );

      allow update, delete: if isAdmin();
    }
  }
}
