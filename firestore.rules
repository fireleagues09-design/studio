
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isAdmin', false) == true;
    }

    function isSupport() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isSupport', false) == true;
    }

    function isEmployee() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             (get(userPath).data.get('isEmployee', false) == true || get(userPath).data.get('isEmployee', 0) == 1);
    }

    function isStaff() {
        return isAdmin() || isSupport() || isEmployee();
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {
      allow get, create, update: if isUserAuthenticated() && request.auth.uid == userId;
      allow get, list: if isStaff();
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isStaff();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ======================
    // ✅ SUPPORT CHAT SYSTEM (UNIFIED FIX)
    // ======================
    match /chats/{chatId} {
      // allow any authenticated user to see and create chats for themselves or for staff queue
      allow read, create: if isUserAuthenticated();
      
      // allow staff to update session status (assigning, closing)
      allow update: if isUserAuthenticated();
      allow delete: if isAdmin();

      // MESSAGES Subcollection
      match /messages/{messageId} {
        // Simple permissive rules for real-time sync
        allow read, create: if isUserAuthenticated();
        allow update, delete: if isStaff();
      }
    }

    // ======================
    // Other Collections
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isStaff();
        allow create: if request.auth.uid == userId;
        allow update: if isStaff();
        allow delete: if false;
      }
    }

    match /transactions/{transactionId} {
      allow list: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow update: if isStaff();
      allow create: if isUserAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
