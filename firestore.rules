rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read anyone's profile, but only write to their own.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone can read tournaments. Only admins can create/update/delete them.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can only read their own transactions. Admins can manage all transactions.
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
    
    // Anyone can read sliders. Only admins can write to them.
    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
