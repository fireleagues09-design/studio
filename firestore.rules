
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Safer role checks: we prioritize the owner check in the users collection to avoid recursion
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isAdmin', false) == true;
    }

    function isSupport() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isSupport', false) == true;
    }

    function isEmployee() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             (get(userPath).data.get('isEmployee', false) == true || get(userPath).data.get('isEmployee', 0) == 1 || get(userPath).data.get('isAdmin', false) == true);
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {
      // CRITICAL: Check owner FIRST. If the user is reading their own doc, we don't call isAdmin/isSupport.
      allow get: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin() || isEmployee());
      allow list: if isAdmin() || isEmployee();
      allow create: if isUserAuthenticated() && request.auth.uid == userId;
      allow update: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isAdmin();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ======================
    // ✅ CHAT SUPPORT SYSTEM
    // ======================
    match /chats/{chatId} {
      // Normal user creates their own chat
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Players can read/list their own. Support staff can read all.
      allow read, list: if isUserAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isSupport()
      );
      
      // Players can update status/lastMessageTime. Support can update assignedAdmin.
      allow update: if isUserAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isSupport()
      );

      allow delete: if isAdmin();
    }

    // Messages Root Collection
    match /messages/{chatId}/chat/{msgId} {
      // Access allowed if user is Support or the Chat Owner or the Assigned Admin
      allow read, write: if isUserAuthenticated() && (
        isSupport() ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.get('assignedAdmin', null) == request.auth.uid
      );
    }

    // ======================
    // Other Collections
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /transactions/{transactionId} {
      allow list: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow create: if isUserAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
