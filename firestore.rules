
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isAdmin', false) == true;
    }

    function isSupport() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isSupport', false) == true;
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {
      // Allow owner to read/write their own profile
      allow get, create, update: if isUserAuthenticated() && request.auth.uid == userId;
      // Allow admins or staff to search/view users
      allow get, list: if isAdmin() || isSupport();
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isAdmin();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ======================
    // ✅ CHAT SUPPORT SYSTEM (FINAL FIX - PERMISSIVE AUTH READ)
    // ======================
    match /chats/{chatId} {
      // allow authenticated user to create and read chats
      // simplified to avoid strict property checks that trigger recursion
      allow create, read, list: if isUserAuthenticated();

      // allow staff to pick/update chats
      allow update: if isUserAuthenticated() && (isAdmin() || isSupport() || request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();

      // ======================
      // MESSAGES (Subcollection)
      // ======================
      match /messages/{messageId} {
        // allow sending and reading if logged in
        allow create, read, list: if isUserAuthenticated();

        allow update, delete: if isAdmin();
      }
    }

    // ======================
    // Other Collections
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || isSupport();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /transactions/{transactionId} {
      allow list: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow create: if isUserAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
