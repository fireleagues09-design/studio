rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access for tournaments and sliders, but restrict writes to authenticated users.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Secure user data: only the logged-in user can access their own document.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Secure transactions: only the logged-in user can access their own transactions.
    match /transactions/{transactionId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Disallow updates and deletes from the client for security.
      allow update, delete: if false;
    }
  }
}
