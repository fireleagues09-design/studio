
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Fetch user data directly to avoid circular dependency in rules
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && exists(path) && get(path).data.isAdmin == true;
    }

    function isEmployee() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && exists(path) && 
             (get(path).data.isEmployee == true || get(path).data.isEmployee == 1);
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {
      // Owners can always get their own data. Admins/Employees can see all.
      allow get: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin() || isEmployee());
      allow list: if isAdmin() || isEmployee();
      allow create: if isUserAuthenticated() && request.auth.uid == userId;
      allow update: if isUserAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isAdmin();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ======================
    // ✅ CHAT SUPPORT SYSTEM
    // ======================
    match /chats/{chatId} {
      // Player creates their own chat
      allow create: if isUserAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      
      // Players can read their own. Admins can read all to see the queue.
      allow read: if isUserAuthenticated() && (
        request.auth.uid == resource.data.createdBy || 
        request.auth.uid == resource.data.assignedAdmin ||
        isAdmin()
      );
      
      // Players can update status (close) or lastMessageTime. Admins handle assignments.
      allow update: if isUserAuthenticated() && (
        request.auth.uid == resource.data.createdBy || 
        request.auth.uid == resource.data.assignedAdmin ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Messages Root Collection (Secured)
    // Structure: /messages/{chatId}/chat/{msgId}
    match /messages/{chatId}/chat/{msgId} {
      allow read, write: if isUserAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.assignedAdmin == request.auth.uid
      );
    }

    // ======================
    // Other Collections
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /transactions/{transactionId} {
      allow list: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow create: if isUserAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
