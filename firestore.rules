
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) && get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true;
    }
    
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the requesting user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can only read/write their own data.
    // New users can create their own document during registration.
    match /users/{userId} {
      allow read, update: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated();
    }
    
    // Admins can manage other user documents (e.g. for user management page)
    match /users/{userId} {
        allow get, list, update: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // Tournaments are public to read. Only admins can create/update/delete.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && isAdmin(request.auth.uid);
      
      // Users can register for a tournament. Admins can read registrations.
      match /registrations/{userId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin(request.auth.uid));
        allow create: if isAuthenticated() && isOwner(userId);
        allow list: if isAuthenticated() && isAdmin(request.auth.uid);
        allow delete, update: if isAuthenticated() && isAdmin(request.auth.uid);
      }
    }
    
    // Sliders are public to read. Only admins can create/update/delete.
    match /sliders/{sliderId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    // Transactions can be created by the owner. Only admins can read/update them.
    match /transactions/{transactionId} {
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow read, update, delete: if isAuthenticated() && isAdmin(request.auth.uid);
      allow list: if isAuthenticated() && isAdmin(request.auth.uid);
    }
    
    // Users should be able to query their own transactions
    match /transactions/{transactionId} {
       allow list, get: if isAuthenticated() && get(/databases/$(database)/documents/transactions/$(transactionId)).data.userId == request.auth.uid;
    }
    
    // Admin-only collections
    match /adminLogs/{logId} {
        allow read, write: if isAuthenticated() && isAdmin(request.auth.uid);
    }

    match /deletedUsers/{deletedId} {
       allow read, write: if isAuthenticated() && isAdmin(request.auth.uid);
    }
  }
}
