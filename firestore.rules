
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can be read by anyone, but only created by the user themselves.
    // Users can update their own inGameName.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inGameName']);
    }

    // Tournaments can be read by anyone, but only created/updated/deleted by an admin.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Sliders can be read by anyone, but only created/deleted by an admin.
    match /sliders/{sliderId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Transactions can only be read or created by the user they belong to.
    // Admins can update transactions (e.g., to approve a deposit).
    match /transactions/{transactionId} {
      allow read, create: if request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
    }
  }
}
