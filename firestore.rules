rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin status
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can only read/update their own data. Anyone can create a user doc (for registration).
    match /users/{userId} {
      allow read;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if false; // Generally, users shouldn't delete their own accounts directly
    }

    // Anyone can read tournaments. Only admins can write.
    match /tournaments/{tournamentId} {
      allow read;
      allow write: if isAdmin();
    }
    
    // Users can only read their own transactions. Admins can write.
    match /transactions/{transactionId} {
       allow read: if request.auth.uid == resource.data.userId;
       allow write: if isAdmin();
    }
    
    // Anyone can read sliders. Only admins can write.
    match /sliders/{sliderId} {
      allow read;
      allow write: if isAdmin();
    }
  }
}
