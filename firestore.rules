    // Helper function to check if the current user is an admin.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // A user can get their own profile, or an admin can get any profile.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Only admins can list all users.
      allow list: if isAdmin();

      // A user can update their own inGameName.
      // This rule is specific and prevents other fields from being changed by the user.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['inGameName']);

      // A logged-in user can create their own profile document.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Rules for the 'teams' subcollection within a user document.
      match /teams/{teamId} {
        // A user can read their own teams. Admins can read any.
        allow read: if request.auth != null;

        // A user can create or delete their own team documents.
        allow create, delete: if request.auth != null && request.auth.uid == userId;

        // A user can update their team members or category.
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data).changedKeys()
                            .hasOnly(['members', 'category']);
        
        // Admins have full access to manage any user's teams.
        allow read, write, list: if isAdmin();
      }
    }

    // Rules for the 'sliders' collection
    match /sliders/{sliderId} {
      // Anyone can view sliders.
      allow read: if true;
      // Only admins can create, update, or delete sliders.
      allow write: if isAdmin();
    }

    // Rules for the 'banners' collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rules for the 'settings' collection
    match /settings/{settingId} {
      // Only admins can manage settings.
      allow read, write: if isAdmin();
