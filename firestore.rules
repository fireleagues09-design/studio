
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // Helper Functions
    // ======================
    function isUserAuthenticated() {
      return request.auth != null;
    }

    // Role checks: These functions read the user's document.
    // To avoid recursion, we check owner permissions separately in the user collection match.
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isAdmin', false) == true;
    }

    function isSupport() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             get(userPath).data.get('isSupport', false) == true;
    }

    function isEmployee() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isUserAuthenticated() && 
             exists(userPath) && 
             (get(userPath).data.get('isEmployee', false) == true || get(userPath).data.get('isAdmin', false) == true);
    }

    // ======================
    // Users Collection
    // ======================
    match /users/{userId} {
      // Owner can always read/write their own document. 
      // No role functions called here to prevent circular recursion.
      allow get, create, update: if isUserAuthenticated() && request.auth.uid == userId;
      
      // Staff can read and list other profiles
      allow get, list: if isAdmin() || isEmployee();
      
      allow delete: if isAdmin();

      match /teams/{teamId} {
        allow read: if true;
        allow list: if isAdmin();
        allow create, delete, update: if (isUserAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // ======================
    // ✅ CHAT SUPPORT SYSTEM
    // ======================
    match /chats/{chatId} {
      // Players create their own sessions. Data must include their userId.
      allow create: if isUserAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Players can read/list their own sessions. Support staff can see all active ones.
      allow read, list: if isUserAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isSupport() ||
        isAdmin()
      );
      
      // Both can update status (staff to pick, player to close) or lastMessageTime.
      allow update: if isUserAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        isSupport() ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Messages Root Collection
    match /messages/{chatId}/chat/{msgId} {
      // Access allowed if user is Support, Admin, or the Chat Owner
      // We check ownership by reading the parent chat document.
      allow read, write: if isUserAuthenticated() && (
        isSupport() ||
        isAdmin() ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid
      );
    }

    // ======================
    // Other Collections
    // ======================
    match /tournaments/{tournamentId} {
      allow read, list: if true;
      allow create, update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();

      match /registrations/{userId} {
        allow read, list: if request.auth.uid == userId || isAdmin();
        allow create: if request.auth.uid == userId;
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    match /transactions/{transactionId} {
      allow list: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isUserAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow create: if isUserAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }
    
    match /{sliderCollection in ['homeSliders', 'landingSliders']}/{sliderId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
        allow read, list, create: if isAdmin();
        allow update, delete: if false;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
