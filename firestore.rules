
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check for admin privileges
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can be read by their own authenticated user or an admin.
    // Users can create their own document on registration.
    // Users can only update their own inGameName.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && request.resource.data.keys().hasOnly(['inGameName']);
    }

    // Tournaments can be read by anyone.
    // Only admins can create, update, or delete tournaments.
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Sliders can be read by anyone.
    // Only admins can create or delete sliders.
    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Transactions can be read by the associated user or an admin.
    // Users can create their own transaction documents (for deposit requests).
    match /transactions/{transactionId} {
        allow read: if request.auth.uid == resource.data.userId || isAdmin();
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin();
    }
  }
}
